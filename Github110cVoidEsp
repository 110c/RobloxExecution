local function getTorso(plr)
    local c = plr.Character; if not c then return nil end
    return c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso") or c:FindFirstChild("HumanoidRootPart")
end
local function getHead(plr)
    local c = plr.Character; if not c then return nil end
    return c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart")
end
local function getRoot(plr)
    local c = plr.Character; if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart")
end
local function getDotPx() return 4 + state.size * 2 end

local function createDot(plr, torso)
    local b = trackedDots[plr]
    if not b or not b.Parent then
        b = Instance.new("BillboardGui")
        b.Name = "Dot_" .. plr.Name
        b.Size = UDim2.fromOffset(getDotPx(), getDotPx())
        b.AlwaysOnTop = true; b.LightInfluence = 0; b.ResetOnSpawn = false
        b.Parent = espFolder

        local dot = Instance.new("Frame")
        dot.Name = "Fill"; dot.Size = UDim2.fromScale(1, 1)
        dot.BackgroundColor3 = theme.accent; dot.BorderSizePixel = 0; dot.Parent = b
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1, 0); c.Parent = dot
        local s = Instance.new("UIStroke"); s.Name = "Ring"
        s.Color = Color3.new(1, 1, 1); s.Thickness = 1.5; s.Transparency = 0.05; s.Parent = dot

        trackedDots[plr] = b
    end
    b.Adornee = torso
    return b
end

local function updateDotSize()
    local px = getDotPx()
    for _, b in pairs(trackedDots) do
        if b.Parent then b.Size = UDim2.fromOffset(px, px) end
    end
end

local function createLabel(plr, head)
    local b = trackedLabels[plr]
    if not b or not b.Parent then
        b = Instance.new("BillboardGui")
        b.Name = "Label_" .. plr.Name
        b.Size = UDim2.fromOffset(220, 22)
        b.StudsOffset = Vector3.new(0, 2.4, 0)
        b.AlwaysOnTop = true; b.LightInfluence = 0; b.ResetOnSpawn = false
        b.Parent = espFolder

        local lbl = Instance.new("TextLabel")
        lbl.Name = "Text"; lbl.Size = UDim2.fromScale(1, 1)
        lbl.BackgroundTransparency = 1; lbl.Text = ""
        lbl.TextColor3 = Color3.new(1, 1, 1)
        lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
        lbl.TextStrokeTransparency = 0
        lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 13
        lbl.TextXAlignment = Enum.TextXAlignment.Center; lbl.Parent = b

        trackedLabels[plr] = b
    end
    b.Adornee = head
    return b
end

local function updateLabelText(plr, label, distance)
    local lbl = label:FindFirstChild("Text")
    if not lbl then return end
    local distStr = string.format("%d studs", math.floor(distance + 0.5))
    if state.name and state.distance then
        lbl.Text = string.format("%s [%s]", plr.Name, distStr)
    elseif state.name then
        lbl.Text = plr.Name
    elseif state.distance then
        lbl.Text = distStr
    else
        lbl.Text = ""
    end
end

local function createHighlight(plr)
    local char = plr.Character; if not char then return nil end
    local hl = trackedHL[plr]
    if not hl or not hl.Parent then
        hl = Instance.new("Highlight")
        hl.Name = "HL_" .. plr.Name
        hl.FillColor = FILL_WHITE
        hl.FillTransparency = 0.55
        hl.OutlineColor = theme.accent
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = espFolder
        trackedHL[plr] = hl
    end
    hl.Adornee = char
    hl.OutlineColor = theme.accent
    return hl
end

local function removeDot(p)   if trackedDots[p]   then trackedDots[p]:Destroy();   trackedDots[p]   = nil end end
local function removeLabel(p) if trackedLabels[p] then trackedLabels[p]:Destroy(); trackedLabels[p] = nil end end
local function removeHL(p)    if trackedHL[p]     then trackedHL[p]:Destroy();     trackedHL[p]     = nil end end
local function removeAllFor(p) removeDot(p); removeLabel(p); removeHL(p) end
local function clearAll()
    for _, v in pairs(trackedDots)   do v:Destroy() end
    for _, v in pairs(trackedLabels) do v:Destroy() end
    for _, v in pairs(trackedHL)     do v:Destroy() end
    trackedDots, trackedLabels, trackedHL = {}, {}, {}
end

local function espLoop()
    local localRoot = getRoot(player)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local char = plr.Character
            local hasChar = char and char.Parent

            if hasChar then
                if state.dot then
                    local torso = getTorso(plr)
                    if torso then createDot(plr, torso) end
                else removeDot(plr) end

                if state.name or state.distance then
                    local head = getHead(plr); local root = getRoot(plr)
                    if head then
                        local label = createLabel(plr, head)
                        local dist = 0
                        if localRoot and root then
                            dist = (root.Position - localRoot.Position).Magnitude
                        end
                        updateLabelText(plr, label, dist)
                    end
                else removeLabel(plr) end

                if state.highlight then createHighlight(plr) else removeHL(plr) end
            else
                removeAllFor(plr)
            end
        end
    end
    for plr in pairs(trackedDots) do
        if not Players:FindFirstChild(plr.Name) then removeAllFor(plr) end
    end
    for plr in pairs(trackedLabels) do
        if not Players:FindFirstChild(plr.Name) then removeAllFor(plr) end
    end
    for plr in pairs(trackedHL) do
        if not Players:FindFirstChild(plr.Name) then removeAllFor(plr) end
    end
end

local function startLoop() if not loopConn then loopConn = RunService.RenderStepped:Connect(espLoop) end end
local function stopLoop()  if loopConn then loopConn:Disconnect(); loopConn = nil end clearAll() end
local function refreshLoopState() if anyEnabled() then startLoop() else stopLoop() end end

local function hookPlayer(plr)
    if plr == player then return end
    plr.CharacterAdded:Connect(function()
        removeAllFor(plr)
        if anyEnabled() then
            task.wait(0.15)
            pcall(espLoop)
        end
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do hookPlayer(plr) end
Players.PlayerAdded:Connect(hookPlayer)
Players.PlayerRemoving:Connect(removeAllFor)

task.spawn(function()
    while true do
        task.wait(0.9)
        if anyEnabled() then
            if not loopConn or not loopConn.Connected then
                loopConn = nil
                startLoop()
            else
                pcall(espLoop)
            end
        end
    end
end)

