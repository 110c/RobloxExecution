local FEATURE_LABELS = { speedwalk = "Speedwalk", infiniteJump = "Infinite Jump", noclip = "Noclip" }

local function getSelectedList()
    local list = {}
    if state.speedwalk    then table.insert(list, FEATURE_LABELS.speedwalk)    end
    if state.infiniteJump then table.insert(list, FEATURE_LABELS.infiniteJump) end
    if state.noclip       then table.insert(list, FEATURE_LABELS.noclip)       end
    return list
end

local function refreshToggleVisual(card, stroke, label, indicator, enabled)
    if enabled then
        card.BackgroundColor3 = theme.bgMid:Lerp(theme.accent, 0.28)
        stroke.Color = theme.accent
        stroke.Transparency = 0
        indicator.BackgroundColor3 = theme.accent
    else
        card.BackgroundColor3 = theme.bgMid
        stroke.Color = theme.accentDk
        stroke.Transparency = 0.2
        indicator.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
    end
end

local function refreshAllToggles()
    refreshToggleVisual(speedCard,  speedS,  speedL,  speedI,  state.speedwalk)
    refreshToggleVisual(jumpCard,   jumpS,   jumpL,   jumpI,   state.infiniteJump)
    refreshToggleVisual(noclipCard, noclipS, noclipL, noclipI, state.noclip)
end

local function refreshStatus()
    local list = getSelectedList()
    local suffix = (#list == 0) and "None" or table.concat(list, " + ")
    statusLabel.Text = masterOn and ("Features Enabled: " .. suffix) or ("Features Disabled: " .. suffix)
    statusDot.BackgroundColor3 = (#list > 0) and theme.accent or Color3.fromRGB(70, 70, 80)
end

local function refreshMasterVisual()
    if masterOn then
        masterBtn.Text = "ENABLED"
        masterBtn.BackgroundColor3 = theme.bgMid:Lerp(theme.accent, 0.3)
        mbs.Color = theme.accent
        mbs.Transparency = 0
    else
        masterBtn.Text = "DISABLED"
        masterBtn.BackgroundColor3 = theme.bgMid
        mbs.Color = theme.accentDk
        mbs.Transparency = 0.2
    end
end

local function applyTheme(name)
    currentThemeName = name
    theme = THEMES[name]

    main.BackgroundColor3 = theme.bgDark
    ms.Color = theme.accent
    glow.BackgroundColor3 = theme.accent
    mg.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, theme.bgMid),
        ColorSequenceKeypoint.new(1, theme.bgDark),
    })

    titleLabel.TextStrokeColor3 = theme.accent
    masterBtn.TextStrokeColor3  = theme.accent
    speedL.TextStrokeColor3 = theme.accent
    jumpL.TextStrokeColor3  = theme.accent
    noclipL.TextStrokeColor3 = theme.accent
    statusLabel.TextStrokeColor3 = theme.accent
    watermark.TextStrokeColor3 = theme.accent
    if speedBox then speedBox.TextStrokeColor3 = theme.accent end

    refreshMasterVisual()
    refreshAllToggles()
    refreshStatus()

    if speedBox then
        speedBox.BackgroundColor3 = theme.bgDark
        for _, ch in ipairs(speedBox:GetChildren()) do
            if ch:IsA("UIStroke") then ch.Color = theme.accentDk end
        end
    end

    for nameKey, ref in pairs(swatchRefs) do
        ref.stroke.Transparency = (nameKey == currentThemeName) and 0 or 1
    end
end

