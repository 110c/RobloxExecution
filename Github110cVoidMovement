local originalSpeed = 16
local originalCollide = {}

local function setupCharacter()
    character = player.Character or player.CharacterAdded:Wait()
    humanoid  = character:WaitForChild("Humanoid")
    originalSpeed = humanoid.WalkSpeed
end

setupCharacter()

local function anyEnabled()
    return masterOn and (state.speedwalk or state.infiniteJump or state.noclip)
end

local function stopNoclip()
    if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
    for part, wasCollide in pairs(originalCollide) do
        if part and part.Parent then part.CanCollide = wasCollide end
    end
    originalCollide = {}
end

local function startNoclip()
    stopNoclip()
    noclipConn = RunService.Stepped:Connect(function()
        if not state.noclip or not character then return end
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if originalCollide[part] == nil then
                    originalCollide[part] = part.CanCollide
                end
                part.CanCollide = false
            end
        end
    end)
end

local function stopInfJump()
    if infJumpConn then infJumpConn:Disconnect(); infJumpConn = nil end
end

local function startInfJump()
    stopInfJump()
    if humanoid then
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
    end
    infJumpConn = UserInputService.JumpRequest:Connect(function()
        if not state.infiniteJump then return end
        if humanoid and humanoid.Parent then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)
end

local function stopSpeedwalk()
    if speedHeartbeatConn then speedHeartbeatConn:Disconnect(); speedHeartbeatConn = nil end
    if humanoid and humanoid.Parent then
        humanoid.WalkSpeed = originalSpeed
    end
end

local function startSpeedwalk()
    stopSpeedwalk()
    speedHeartbeatConn = RunService.Heartbeat:Connect(function()
        if not state.speedwalk then return end
        if humanoid and humanoid.Parent and humanoid.WalkSpeed ~= state.speed then
            humanoid.WalkSpeed = state.speed
        end
    end)
    if humanoid and humanoid.Parent then
        humanoid.WalkSpeed = state.speed
    end
end

local function refreshFeatures()
    if not anyEnabled() then
        stopNoclip()
        stopInfJump()
        stopSpeedwalk()
        return
    end

    if state.noclip then startNoclip() else stopNoclip() end
    if state.infiniteJump then startInfJump() else stopInfJump() end
    if state.speedwalk then startSpeedwalk() else stopSpeedwalk() end
end

