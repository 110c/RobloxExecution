local CONTAINER_W = MAIN_W - 16
local BASE_PX_PER_SEC = 130
local marqueeX = CONTAINER_W
local currentSpeed = 1
local targetSpeed = 1
local speedTimer = 0
local nextSpeedChange = 0.4 + math.random() * 0.8

RunService.RenderStepped:Connect(function(dt)
    speedTimer = speedTimer + dt
    if speedTimer >= nextSpeedChange then
        speedTimer = 0
        nextSpeedChange = 0.35 + math.random() * 1.15
        targetSpeed = 0.2 + math.random() * 2.3
    end
    currentSpeed = currentSpeed + (targetSpeed - currentSpeed) * math.min(1, dt * 4.5)

    marqueeX = marqueeX - BASE_PX_PER_SEC * currentSpeed * dt
    if marqueeX < -titleTextWidth then
        marqueeX = CONTAINER_W
    end
    titleLabel.Position = UDim2.fromOffset(marqueeX, 0)
end)

local dragging = false
local dragStart, startPos

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local d = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y
        )
    end
end)
