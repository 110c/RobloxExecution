if speedBox then
    speedBox.FocusLost:Connect(function()
        local num = tonumber(speedBox.Text)
        if num then
            num = math.clamp(math.floor(num), 0, 100000)
            state.speed = num
            speedBox.Text = tostring(num)
            if state.speedwalk and humanoid and humanoid.Parent then
                humanoid.WalkSpeed = state.speed
            end
        else
            speedBox.Text = tostring(state.speed)
        end
    end)
end

for nameKey, ref in pairs(swatchRefs) do
    ref.btn.Activated:Connect(function()
        applyTheme(nameKey)
    end)
end

